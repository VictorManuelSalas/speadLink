
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  PROSPECT
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  DAMAGED
  RETIRED
  IN_REPAIR
}

enum RoleType {
  SUPERADMIN
  ADMIN
  MANAGER
  EMPLOYER
  CUSTOM
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  orgCode     String   @unique
  email       String
  phone       String?
  timeZone    String   @default("America/Mexico_City")
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  roles       Role[]
  clients     Client[]
  services    Service[]
  invoices    Invoice[]
  payments    Payment[]
  equipments  Equipment[]
  notes       Note[]

  @@map("organizations")
}

// ============================================================
// ROLES
// ============================================================

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           RoleType @default(CUSTOM)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]

  @@unique([organizationId, name])

  @@map("roles")
}

// ============================================================
// USERS
// ============================================================

model User {
  id               String      @id @default(cuid())
  organizationId   String
  roleId           String

  name             String
  username         String
  email            String
  password         String

  status           UserStatus @default(ACTIVE)

  lastLoginAt      DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  createdById      String?
  updatedById      String?
  deletedById      String?

  createdSource    String?
  updatedSource    String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role @relation(fields: [roleId], references: [id])

  notes            Note[] @relation("NoteCreatedBy")

  createdBy        User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy        User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deletedBy        User? @relation("UserDeletedBy", fields: [deletedById], references: [id])

  createdUsers     User[] @relation("UserCreatedBy")
  updatedUsers     User[] @relation("UserUpdatedBy")
  deletedUsers     User[] @relation("UserDeletedBy")

  @@unique([organizationId, email])
  @@unique([organizationId, username])

  @@index([organizationId])

  @@map("users")
}

// ============================================================
// CLIENTS
// ============================================================

model Client {
  id             String       @id @default(cuid())
  organizationId String

  name           String

  email          String?
  phone          String?
  cellphone      String?

  street         String?
  city           String?
  state          String?
  zipCode        String?

  latitude       Float?
  longitude      Float?

  status         ClientStatus @default(ACTIVE)

  billingDay     Int @default(1)

  notesText      String?

  customFields   Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  createdSource  String?
  updatedSource  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoices       Invoice[]
  payments       Payment[]

  createdBy      User? @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy      User? @relation("ClientUpdatedBy", fields: [updatedById], references: [id])
  deletedBy      User? @relation("ClientDeletedBy", fields: [deletedById], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])

  @@map("clients")
}

// ============================================================
// NOTES (POLYMORPHIC)
// ============================================================

model Note {
  id             String   @id @default(cuid())

  organizationId String

  module         String
  recordId       String

  title          String?
  message        String

  isPinned       Boolean @default(false)
  isInternal     Boolean @default(true)

  createdById    String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy      User @relation("NoteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([module, recordId])

  @@map("notes")
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id             String   @id @default(cuid())

  organizationId String

  name           String
  description    String?

  price          Decimal @db.Decimal(12,2)

  isActive       Boolean @default(true)

  customFields   Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  createdSource  String?
  updatedSource  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy      User? @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy      User? @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])
  deletedBy      User? @relation("ServiceDeletedBy", fields: [deletedById], references: [id])

  @@index([organizationId])

  @@map("services")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id             String @id @default(cuid())

  organizationId String
  clientId       String

  folio          String

  status         InvoiceStatus @default(PENDING)

  issueDate      DateTime @default(now())
  dueDate        DateTime

  subtotal       Decimal @db.Decimal(12,2)
  taxAmount      Decimal @db.Decimal(12,2)
  total          Decimal @db.Decimal(12,2)

  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  createdSource  String?
  updatedSource  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client @relation(fields: [clientId], references: [id])

  payments       Payment[]

  createdBy      User? @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy      User? @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  deletedBy      User? @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])

  @@unique([organizationId, folio])

  @@index([organizationId])
  @@index([clientId])

  @@map("invoices")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id             String @id @default(cuid())

  organizationId String
  clientId       String
  invoiceId      String?

  amount         Decimal @db.Decimal(12,2)

  paidAt         DateTime @default(now())

  reference      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  createdById    String?
  updatedById    String?
  deletedById    String?

  createdSource  String?
  updatedSource  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client @relation(fields: [clientId], references: [id])
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])

  createdBy      User? @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  updatedBy      User? @relation("PaymentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy      User? @relation("PaymentDeletedBy", fields: [deletedById], references: [id])

  @@index([organizationId])
  @@index([clientId])

  @@map("payments")
}

// ============================================================
// EQUIPMENTS
// ============================================================

model Equipment {
  id                String @id @default(cuid())

  organizationId    String

  name              String
  brand             String?
  model             String?

  serialNumber      String?
  macAddress        String?

  status            EquipmentStatus @default(AVAILABLE)

  ipAddress         String?

  pppoeUser         String?
  pppoePassword     String?

  firmwareVersion   String?

  lastSeenAt        DateTime?

  customFields      Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  createdById       String?
  updatedById       String?
  deletedById       String?

  createdSource     String?
  updatedSource     String?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy         User? @relation("EquipmentCreatedBy", fields: [createdById], references: [id])
  updatedBy         User? @relation("EquipmentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy         User? @relation("EquipmentDeletedBy", fields: [deletedById], references: [id])

  @@index([organizationId])
  @@index([status])

  @@map("equipments")
}

// ============================================================
// THIRD PARTY CONNECTIONS
// ============================================================

model ThirdPartyConnection {
  id             String @id @default(cuid())

  organizationId String

  name           String
  provider       String

  config         Json

  isActive       Boolean @default(true)

  lastSyncAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([provider])

  @@map("third_party_connections")
}
